+        private void show_context_menu (Gdk.EventButton event) {
+            remove_noti_timeout ();
+            var popover = new Gtk.Popover (event_box);
+            popover.get_style_context ().add_class ("swaync-context-popover");
+            Gdk.Rectangle rect = { (int) event.x, (int) event.y, 1, 1 };
+            popover.set_pointing_to (rect);
+            popover.set_position (Gtk.PositionType.BOTTOM);
+
+            var box = new Gtk.Box (Gtk.Orientation.VERTICAL, 6);
+            box.margin_start = 8;
+            box.margin_end = 8;
+            box.margin_top = 8;
+            box.margin_bottom = 8;
+
+            string display = get_app_display_name ();
+            var btn_blacklist = new Gtk.Button.with_label ("🚫 Blacklister " + display);
+            btn_blacklist.get_style_context ().add_class ("popover-btn-blacklist");
+            btn_blacklist.clicked.connect (() => {
+                popover.popdown ();
+                blacklist_current_app ();
+                this.close_notification ();
+            });
+            box.add (btn_blacklist);
+
+            var btn_close = new Gtk.Button.with_label ("✕ Fermer");
+            btn_close.get_style_context ().add_class ("popover-btn-close");
+            btn_close.clicked.connect (() => {
+                popover.popdown ();
+                this.close_notification ();
+            });
+            box.add (btn_close);
+
+            popover.add (box);
+            popover.show_all ();
+            popover.popup ();
+        }
