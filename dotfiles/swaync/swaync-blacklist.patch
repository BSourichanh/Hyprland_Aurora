+        private string get_app_display_name () {
+            string? entry = (param.desktop_entry != null && param.desktop_entry.strip ().length > 0) ? param.desktop_entry.strip () : null;
+            string? app = (param.app_name != null && param.app_name.strip ().length > 0) ? param.app_name.strip () : null;
+
+            if (entry != null) {
+                string base_name = entry.replace (".desktop", "");
+                string clean_snap = base_name.replace ("snap.", "");
+                string[] candidates = {
+                    base_name,
+                    base_name.down (),
+                    clean_snap,
+                    clean_snap.down (),
+                    clean_snap + "_" + clean_snap,
+                    clean_snap.down () + "_" + clean_snap.down ()
+                };
+                foreach (string c in candidates) {
+                    var app_info = new DesktopAppInfo (c + ".desktop");
+                    if (app_info != null) {
+                        string disp = app_info.get_display_name ();
+                        if (disp != null && disp.length > 0) return disp;
+                    }
+                }
+                return clean_snap;
+            }
+
+            if (app != null) {
+                string base_name = app.replace (".desktop", "");
+                var app_info = new DesktopAppInfo (base_name + ".desktop");
+                if (app_info != null) {
+                    string disp = app_info.get_display_name ();
+                    if (disp != null && disp.length > 0) return disp;
+                }
+                return app;
+            }
+
+            return "l'application";
+        }
+
+        private void blacklist_current_app () {
+            string app = (param.app_name != null && param.app_name.strip ().length > 0) ? param.app_name.strip () : "";
+            string entry = (param.desktop_entry != null && param.desktop_entry.strip ().length > 0) ? param.desktop_entry.strip () : "";
+            string display = get_app_display_name ();
+
+            if (app.length == 0 && entry.length == 0 && display == "l'application") return;
+
+            try {
+                string script = Path.build_filename (
+                    Environment.get_user_config_dir (),
+                    "swaync",
+                    "scripts",
+                    "blacklist-app.py"
+                );
+                string[] argv = { script, app, entry, display };
+                Pid pid;
+                Process.spawn_async (
+                    null,
+                    argv,
+                    null,
+                    SpawnFlags.SEARCH_PATH,
+                    null,
+                    out pid
+                );
+            } catch (Error e) {
+                warning ("Failed to blacklist application: %s\n", e.message);
+            }
+        }
