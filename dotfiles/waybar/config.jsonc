{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 2,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "group/spotify-player",
        "clock"
    ],
    "modules-right": [
        "cpu",
        "custom/gpu",
        "memory",
        "pulseaudio",
        "network",
        "custom/notification",
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": false,
        "sort-by-number": true
    },
    "mpris": {
        "player": "spotify",
        "format": "<span color='#00f0ff'>{player_icon}</span>  {dynamic}",
        "format-paused": "<span color='#94a3b8'>{player_icon}</span>  <i>{dynamic}</i>",
        "format-stopped": "",
        "player-icons": {
            "default": "\uf1bc"
        },
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-separator": " \u2022 ",
        "dynamic-len": 28,
        "max-length": 32,
        "ellipsis": "\u2026",
        "tooltip": true,
        "tooltip-format": "{title} \u2022 {artist} ({album})\n\nClic gauche : Carte d\u00e9roulante\nClic droit : Lecture / Pause\nClic milieu : Piste suivante\nMolette : Avancer / Reculer (5s)",
        "on-click": "~/.config/waybar/scripts/spotify-card.py toggle",
        "on-click-right": "python3 ~/.config/waybar/scripts/spotify_ipc.py play-pause",
        "on-click-middle": "python3 ~/.config/waybar/scripts/spotify_ipc.py next",
        "on-scroll-up": "python3 ~/.config/waybar/scripts/spotify_ipc.py position +5",
        "on-scroll-down": "python3 ~/.config/waybar/scripts/spotify_ipc.py position -5"
    },
    "clock": {
        "locale": "fr_FR.UTF-8",
        "format": "<span color='#00f0ff'>\uf017</span>  {:%H:%M  \u2022  %A %d %B}",
        "format-alt": "<span color='#00f0ff'>\uf133</span>  {:%d/%m/%Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#00f0ff'><b>{}</b></span>",
                "days": "<span color='#e1e4f1'><b>{}</b></span>",
                "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    "pulseaudio": {
        "format": "<span color='#00f0ff'>{icon}</span>  {volume}%",
        "format-muted": "<span color='#64748b'>\uf026</span>  Muet",
        "format-icons": {
            "default": [
                "\uf026",
                "\uf027",
                "\uf028"
            ]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "<span color='#00f0ff'>\uf1eb</span>  {essid}",
        "format-ethernet": "<span color='#00f0ff'>\uf0e8</span>  Connect\u00e9",
        "format-disconnected": "<span color='#f87171'>\u26a0</span>  D\u00e9connect\u00e9",
        "tooltip-format": "{ifname} : {ipaddr}"
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.py",
        "return-type": "json",
        "restart-interval": 3,
        "tooltip": true
    },
    "cpu": {
        "interval": 3,
        "format": "<span color='#00f0ff'>\uf2db</span>  {usage}%",
        "tooltip": true
    },
    "memory": {
        "interval": 5,
        "format": "<span color='#00f0ff'>\uefc5</span>  {percentage}%",
        "tooltip-format": "RAM : {used:0.1f}G / {total:0.1f}G ({percentage}%)"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span color='#00f0ff'>{icon}</span><span foreground='#f43f5e'><sup>{text}</sup></span>",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb | sed -u 's/\"text\": \"0\"/\"text\": \"\"/'",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "group/spotify-player": {
        "orientation": "horizontal",
        "modules": [
            "mpris",
            "custom/spotify-progress",
            "custom/spotify-prev",
            "custom/spotify-play-pause",
            "custom/spotify-next"
        ],
        "spacing": 0
    },
    "custom/spotify-progress": {
        "exec": "~/.config/waybar/scripts/spotify.py --progress",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": true,
        "on-click": "python3 ~/.config/waybar/scripts/spotify_ipc.py play-pause",
        "on-scroll-up": "python3 ~/.config/waybar/scripts/spotify_ipc.py position +5",
        "on-scroll-down": "python3 ~/.config/waybar/scripts/spotify_ipc.py position -5"
    },
    "custom/spotify-prev": {
        "exec": "~/.config/waybar/scripts/spotify.py --prev",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "tooltip": false,
        "on-click": "python3 ~/.config/waybar/scripts/spotify_ipc.py prev"
    },
    "custom/spotify-play-pause": {
        "exec": "~/.config/waybar/scripts/spotify.py --play-pause",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "tooltip": false,
        "on-click": "python3 ~/.config/waybar/scripts/spotify_ipc.py play-pause"
    },
    "custom/spotify-next": {
        "exec": "~/.config/waybar/scripts/spotify.py --next",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "tooltip": false,
        "on-click": "python3 ~/.config/waybar/scripts/spotify_ipc.py next"
    }
}